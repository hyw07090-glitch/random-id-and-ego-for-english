# Discord 클라이언트 객체 생성

# 봇이 준비되었을 때 실행되는 이벤트 핸들러
@client.event
async def on_ready():
    print(f'We have logged in as {client.user}')

@client.event
async def on_message(message):

    if message.author == client.user:
        return

    if message.content.startswith('!roll id'):

        선택 = random.choice(list(인격목록.keys()))
        이미지 = 인격목록[선택]

        file = discord.File(이미지)

        await message.reply(f"🎲 result!\n👉 **{선택}**", file=file,
        mention_author=False)

    if message.content.startswith('!roll ego'):

        선택 = random.choice(list(에고목록.keys()))
        이미지 = 에고목록[선택]

        file = discord.File(이미지)

        await message.reply(f"🎲 result!\n👉 **{선택}**", file=file,
        mention_author=False)

    if message.content.startswith('!test roll'):

        선택 = random.choice(list(test.keys()))
        이미지 = test[선택]

        file = discord.File(이미지)

        await message.reply(f"🎲 result!\n👉 **{선택}**", file=file,
        mention_author=False)

client.run(os.getenv("TOKEN"))
